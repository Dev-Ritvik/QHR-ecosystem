{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "monolith",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@estate/monolith",
        "dev"
      ],
      "port": 3002
    },
    {
      "name": "public",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@estate/public",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "public-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@estate/public",
        "start"
      ],
      "port": 3001
    }
  ]
}
