# Migration/DDL role — CI and local only. NEVER set on a Vercel deployment.
DATABASE_URL_MIGRATIONS="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Seed script target — staging Supabase project only (FR-C27).
DATABASE_URL_SEED="postgresql://postgres:<password>@db.<staging-project-ref>.supabase.co:5432/postgres"

# CI copy for source-map upload of both apps.
SENTRY_AUTH_TOKEN="your_sentry_token"

