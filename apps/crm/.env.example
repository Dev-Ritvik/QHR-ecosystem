# ── Database (core role) ─────────────────────────────────────────────────────
# Authenticates as crm_app: full DML on `core` EXCEPT no UPDATE/DELETE on
# payment_ledger / audit_log (NFR-S7); sole writer of the `projection` schema.
# No DDL — migrations use a separate role that is never deployed (see repo root).
DATABASE_URL="postgresql://crm_app:<password>@<supabase-pooler-host>:6543/postgres"

# ── Supabase services (server only — bypasses RLS, never expose) ─────────────
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # Storage: media pipeline + signed KYC URLs

# ── Better Auth ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET="<random-32B-hex>"
BETTER_AUTH_URL="https://crm.example.com"

# ── OTP & notification delivery ──────────────────────────────────────────────
EMAIL_API_KEY="<resend-or-equivalent-key>"
EMAIL_FROM="office@example.com"
SMS_API_KEY="<msg91-or-equivalent-key>"          # DLT-registered, India
SMS_SENDER_ID="<dlt-sender-id>"

# ── Presentation device tokens (CRM signs; apps/public only verifies) ────────
DEVICE_TOKEN_PRIVATE_KEY="<base64 Ed25519 private key>"

# ── One-way valves from/to apps/public ───────────────────────────────────────
LEAD_INTAKE_SECRET="<same value as apps/public LEAD_INTAKE_SECRET>"
PUBLIC_REVALIDATE_URL="https://example.com/api/revalidate"
PUBLIC_REVALIDATE_SECRET="<same value as apps/public REVALIDATE_SECRET>"

# ── Cron & job heartbeats ────────────────────────────────────────────────────
CRON_SECRET="<random-32B-hex — Vercel Cron auth for hold-expiry, EC alerts, reconcile, weekly export>"
BETTERSTACK_HEARTBEAT_HOLD_EXPIRY="https://uptime.betterstack.com/api/v1/heartbeat/<id>"
BETTERSTACK_HEARTBEAT_RECONCILE="https://uptime.betterstack.com/api/v1/heartbeat/<id>"

# ── Maps (digitizer) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPTILER_API_KEY="<separate key, origin-restricted to crm.example.com>"

# ── Observability ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN="https://<key>@<org>.ingest.sentry.io/<crm-project-id>"
SENTRY_ORG="<org-slug>"
SENTRY_PROJECT="crm"
SENTRY_AUTH_TOKEN="<token>"        # build-time / CI only

# ── App identity ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://crm.example.com"

# NOTE: no PostHog / analytics variables in this app, by policy.
