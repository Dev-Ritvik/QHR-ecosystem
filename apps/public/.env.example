# ── Database (SECURITY BOUNDARY) ─────────────────────────────────────────────
# MUST authenticate as the projection_reader role: SELECT on the `projection`
# schema ONLY. This app must never hold a credential with any grant on `core`.
DATABASE_URL="postgresql://projection_reader:<password>@<supabase-pooler-host>:6543/postgres"

# ── Supabase Realtime (browser — projection status channel only) ────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"   # RLS: anon = SELECT on projection only

# ── One-way valves to the CRM ────────────────────────────────────────────────
LEAD_INTAKE_URL="https://crm.example.com/api/intake/enquiry"
LEAD_INTAKE_SECRET="<random-32B-hex — must match apps/crm>"
REVALIDATE_SECRET="<random-32B-hex — must match apps/crm PUBLIC_REVALIDATE_SECRET>"

# ── Presentation device tokens (verify only — signing key lives in apps/crm)──
DEVICE_TOKEN_PUBLIC_KEY="<base64 Ed25519 public key>"
NEXT_PUBLIC_DEVICE_ENROLLMENT_ENABLED="true"

# ── Maps ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPTILER_API_KEY="<key — origin-restricted to domain.com + present.domain.com>"

# ── Observability ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN="https://<key>@<org>.ingest.sentry.io/<public-project-id>"
SENTRY_ORG="<org-slug>"            # build-time, source-map upload
SENTRY_PROJECT="public"            # build-time
SENTRY_AUTH_TOKEN="<token>"        # build-time / CI only — never runtime

# ── Analytics (PUBLIC SITE ROUTE GROUP ONLY — never loaded in (present)) ─────
NEXT_PUBLIC_POSTHOG_KEY="<phc_...>"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ── Site identity ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://qualityhomesreality.in"
NEXT_PUBLIC_PRESENT_URL="https://present.example.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="+919999999999"
TELEMETRY_INTAKE_URL=http://localhost:3000/api/telemetry
TELEMETRY_INTAKE_SECRET=<shared with apps/crm - openssl rand -hex 32>
